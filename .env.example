# ==============================================================================
# Research Intelligence Assistant Configuration
# ==============================================================================

# LLM Provider Configuration
# Supported providers: openai, anthropic, gemini, groq, ollama, custom
LLM_PROVIDER=openai
LLM_API_KEY=your_api_key_here
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=2048

# Embedding Model Configuration
# Pretrained models: BAAI/bge-base-en-v1.5, sentence-transformers/all-MiniLM-L6-v2, etc.
EMBEDDING_MODEL_NAME=BAAI/bge-base-en-v1.5
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
EMBEDDING_NORMALIZE=true

# Chunking Configuration
CHUNK_SIZE_TOKENS=700
CHUNK_OVERLAP_TOKENS=100
MIN_CHUNK_TOKENS=50

# Retrieval Parameters
DEFAULT_TOP_K=5
RETRIEVAL_SIMILARITY_THRESHOLD=0.0

# Storage Paths
DATA_DIR=data
PAPERS_DIR=data/papers
INDEX_DIR=data/indexes
EVALUATION_DIR=data/evaluation
SQLITE_DB_PATH=data/research_assistant.db

# OCR Configuration
ENABLE_OCR_FALLBACK=true
TESSERACT_CMD=

# Server Configuration
API_HOST=127.0.0.1
API_PORT=8000
